# Brain: scripted | gemini | anthropic
BRAIN=scripted
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_CALL_MODEL=gemini-flash-lite-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Clock: sim (dashboard can advance time) | real (background worker ticks every second)
CLOCK=sim
DB_PATH=counsel.db

# Voice via Twilio ConversationRelay. Set all five for real calls; leave blank for the simulated transport.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL=
