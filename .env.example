# Brain: scripted | gemini | anthropic
BRAIN=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_CALL_MODEL=gemini-flash-lite-latest
# Tried in order when the model above is out of quota or overloaded (free-tier quotas are per model, per day)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3-flash-preview
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Clock: sim (dashboard can advance time) | real (background worker ticks every second)
CLOCK=sim
DB_PATH=counsel.db

# Voice via Twilio ConversationRelay. Set all five for real calls; leave blank for the simulated transport.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL=
